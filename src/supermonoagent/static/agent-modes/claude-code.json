{
  "id": "claude-code",
  "label": "Claude Code",
  "theme": {
    "background": "#1c1511",
    "foreground": "#f5ece3",
    "cursor": "#f8b195",
    "cursorAccent": "#1c1511",
    "selectionBackground": "#344253",
    "selectionForeground": "#f5ece3",
    "black": "#77869a",
    "red": "#ff939f",
    "green": "#f8b195",
    "yellow": "#b9df99",
    "blue": "#ffda9e",
    "magenta": "#dfb8ff",
    "cyan": "#91e2ef",
    "white": "#f5ece3",
    "brightBlack": "#a4afc0",
    "brightRed": "#ffb1b9",
    "brightGreen": "#b9f3b5",
    "brightYellow": "#fff0b1",
    "brightBlue": "#b8dbff",
    "brightMagenta": "#e6c2ff",
    "brightCyan": "#bbf3f4",
    "brightWhite": "#ffffff"
  },
  "tokens": [
    {
      "pattern": "\"[^\"\\n]+\"|\\x27[^\\x27\\n]+\\x27",
      "flags": "gu",
      "color": "#f8b195"
    },
    {
      "pattern": "(?:\\u9519\\u8bef|\\u5931\\u8d25|\\u5f02\\u5e38|\\u8b66\\u544a)|\\b(?:Error|Exception|ERROR|FAIL|FAILED|Warning)\\b",
      "flags": "gu",
      "color": "#ff939f"
    },
    {
      "pattern": "\\b(?:Claude|Thinking|Read|Write|Edit|Bash|Tool|Task)\\b",
      "flags": "giu",
      "color": "#ffda9e"
    },
    {
      "pattern": "[\\p{L}\\p{N}_./\\\\:-]+\\.(?:py|js|jsx|ts|tsx|css|html|json|md|exe|ps1|sh|yaml|yml|toml|java|go|rs|cpp|h)(?::\\d+)?",
      "flags": "gu",
      "color": "#b9df99"
    },
    {
      "pattern": "`[^`\\n]+`|\\b[A-Za-z_][\\w]*\\(\\)",
      "flags": "gu",
      "color": "#dfb8ff"
    },
    {
      "pattern": "\\b\\d+(?:\\.\\d+)?(?:\\s?(?:KiB|MiB|ms|tokens|\\u5b57\\u8282))?",
      "flags": "gu",
      "color": "#dfb8ff"
    }
  ]
}
