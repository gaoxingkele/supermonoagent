{
  "id": "codex",
  "label": "Codex",
  "theme": {
    "background": "#101820",
    "foreground": "#e6edf3",
    "cursor": "#8be9a4",
    "cursorAccent": "#101820",
    "selectionBackground": "#344253",
    "selectionForeground": "#e6edf3",
    "black": "#77869a",
    "red": "#ff939f",
    "green": "#8be9a4",
    "yellow": "#ffe08a",
    "blue": "#82cfff",
    "magenta": "#d7b1ff",
    "cyan": "#91e2ef",
    "white": "#e6edf3",
    "brightBlack": "#a4afc0",
    "brightRed": "#ffb1b9",
    "brightGreen": "#b9f3b5",
    "brightYellow": "#fff0b1",
    "brightBlue": "#b8dbff",
    "brightMagenta": "#e6c2ff",
    "brightCyan": "#bbf3f4",
    "brightWhite": "#ffffff"
  },
  "tokens": [
    {
      "pattern": "\"[^\"\\n]+\"|\\x27[^\\x27\\n]+\\x27",
      "flags": "gu",
      "color": "#8be9a4"
    },
    {
      "pattern": "(?:\\u9519\\u8bef|\\u5931\\u8d25|\\u5f02\\u5e38|\\u8b66\\u544a)|\\b(?:Error|Exception|ERROR|FAIL|FAILED|Warning)\\b",
      "flags": "gu",
      "color": "#ff939f"
    },
    {
      "pattern": "\\b(?:Thinking|Working|Plan|Ran|Explored|Updated|Codex)\\b",
      "flags": "giu",
      "color": "#82cfff"
    },
    {
      "pattern": "[\\p{L}\\p{N}_./\\\\:-]+\\.(?:py|js|jsx|ts|tsx|css|html|json|md|exe|ps1|sh|yaml|yml|toml|java|go|rs|cpp|h)(?::\\d+)?",
      "flags": "gu",
      "color": "#ffe08a"
    },
    {
      "pattern": "`[^`\\n]+`|\\b[A-Za-z_][\\w]*\\(\\)",
      "flags": "gu",
      "color": "#d7b1ff"
    },
    {
      "pattern": "\\b\\d+(?:\\.\\d+)?(?:\\s?(?:KiB|MiB|ms|tokens|\\u5b57\\u8282))?",
      "flags": "gu",
      "color": "#d7b1ff"
    }
  ]
}
