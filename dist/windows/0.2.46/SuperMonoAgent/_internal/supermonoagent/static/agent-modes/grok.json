{
  "id": "grok",
  "label": "Grok",
  "theme": {
    "background": "#10151d",
    "foreground": "#e8f1ff",
    "cursor": "#88dcff",
    "cursorAccent": "#10151d",
    "selectionBackground": "#344253",
    "selectionForeground": "#e8f1ff",
    "black": "#77869a",
    "red": "#ff939f",
    "green": "#88dcff",
    "yellow": "#f9dfa1",
    "blue": "#b6bfff",
    "magenta": "#9ce9c7",
    "cyan": "#91e2ef",
    "white": "#e8f1ff",
    "brightBlack": "#a4afc0",
    "brightRed": "#ffb1b9",
    "brightGreen": "#b9f3b5",
    "brightYellow": "#fff0b1",
    "brightBlue": "#b8dbff",
    "brightMagenta": "#e6c2ff",
    "brightCyan": "#bbf3f4",
    "brightWhite": "#ffffff"
  },
  "tokens": [
    {
      "pattern": "\"[^\"\\n]+\"|\\x27[^\\x27\\n]+\\x27",
      "flags": "gu",
      "color": "#88dcff"
    },
    {
      "pattern": "(?:\\u9519\\u8bef|\\u5931\\u8d25|\\u5f02\\u5e38|\\u8b66\\u544a)|\\b(?:Error|Exception|ERROR|FAIL|FAILED|Warning)\\b",
      "flags": "gu",
      "color": "#ff939f"
    },
    {
      "pattern": "\\b(?:Grok|Reasoning|Search|Searching|Web|Sources|Citations)\\b",
      "flags": "giu",
      "color": "#b6bfff"
    },
    {
      "pattern": "[\\p{L}\\p{N}_./\\\\:-]+\\.(?:py|js|jsx|ts|tsx|css|html|json|md|exe|ps1|sh|yaml|yml|toml|java|go|rs|cpp|h)(?::\\d+)?",
      "flags": "gu",
      "color": "#f9dfa1"
    },
    {
      "pattern": "`[^`\\n]+`|\\b[A-Za-z_][\\w]*\\(\\)",
      "flags": "gu",
      "color": "#9ce9c7"
    },
    {
      "pattern": "\\b\\d+(?:\\.\\d+)?(?:\\s?(?:KiB|MiB|ms|tokens|\\u5b57\\u8282))?",
      "flags": "gu",
      "color": "#9ce9c7"
    }
  ]
}
