{
  "id": "cursor-cli",
  "label": "Cursor CLI",
  "theme": {
    "background": "#121823",
    "foreground": "#e6f0ff",
    "cursor": "#9ccaff",
    "cursorAccent": "#121823",
    "selectionBackground": "#344253",
    "selectionForeground": "#e6f0ff",
    "black": "#77869a",
    "red": "#ff939f",
    "green": "#9ccaff",
    "yellow": "#e9d692",
    "blue": "#9be8dd",
    "magenta": "#dfb3f4",
    "cyan": "#91e2ef",
    "white": "#e6f0ff",
    "brightBlack": "#a4afc0",
    "brightRed": "#ffb1b9",
    "brightGreen": "#b9f3b5",
    "brightYellow": "#fff0b1",
    "brightBlue": "#b8dbff",
    "brightMagenta": "#e6c2ff",
    "brightCyan": "#bbf3f4",
    "brightWhite": "#ffffff"
  },
  "tokens": [
    {
      "pattern": "\"[^\"\\n]+\"|\\x27[^\\x27\\n]+\\x27",
      "flags": "gu",
      "color": "#9ccaff"
    },
    {
      "pattern": "(?:\\u9519\\u8bef|\\u5931\\u8d25|\\u5f02\\u5e38|\\u8b66\\u544a)|\\b(?:Error|Exception|ERROR|FAIL|FAILED|Warning)\\b",
      "flags": "gu",
      "color": "#ff939f"
    },
    {
      "pattern": "\\b(?:Cursor|Agent|Composer|Review|Apply|Applied|Files|Diff)\\b",
      "flags": "giu",
      "color": "#9be8dd"
    },
    {
      "pattern": "[\\p{L}\\p{N}_./\\\\:-]+\\.(?:py|js|jsx|ts|tsx|css|html|json|md|exe|ps1|sh|yaml|yml|toml|java|go|rs|cpp|h)(?::\\d+)?",
      "flags": "gu",
      "color": "#e9d692"
    },
    {
      "pattern": "`[^`\\n]+`|\\b[A-Za-z_][\\w]*\\(\\)",
      "flags": "gu",
      "color": "#dfb3f4"
    },
    {
      "pattern": "\\b\\d+(?:\\.\\d+)?(?:\\s?(?:KiB|MiB|ms|tokens|\\u5b57\\u8282))?",
      "flags": "gu",
      "color": "#dfb3f4"
    }
  ]
}
