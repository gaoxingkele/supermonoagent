{
  "id": "kimi",
  "label": "Kimi",
  "theme": {
    "background": "#0e1a17",
    "foreground": "#e4f7ef",
    "cursor": "#80e8bc",
    "cursorAccent": "#0e1a17",
    "selectionBackground": "#344253",
    "selectionForeground": "#e4f7ef",
    "black": "#77869a",
    "red": "#ff939f",
    "green": "#80e8bc",
    "yellow": "#e8dc99",
    "blue": "#8edeea",
    "magenta": "#babaff",
    "cyan": "#91e2ef",
    "white": "#e4f7ef",
    "brightBlack": "#a4afc0",
    "brightRed": "#ffb1b9",
    "brightGreen": "#b9f3b5",
    "brightYellow": "#fff0b1",
    "brightBlue": "#b8dbff",
    "brightMagenta": "#e6c2ff",
    "brightCyan": "#bbf3f4",
    "brightWhite": "#ffffff"
  },
  "tokens": [
    {
      "pattern": "\"[^\"\\n]+\"|\\x27[^\\x27\\n]+\\x27",
      "flags": "gu",
      "color": "#80e8bc"
    },
    {
      "pattern": "(?:\\u9519\\u8bef|\\u5931\\u8d25|\\u5f02\\u5e38|\\u8b66\\u544a)|\\b(?:Error|Exception|ERROR|FAIL|FAILED|Warning)\\b",
      "flags": "gu",
      "color": "#ff939f"
    },
    {
      "pattern": "\\b(?:Kimi|Moonshot|Thinking|Tool|Todo|Searching|Context)\\b",
      "flags": "giu",
      "color": "#8edeea"
    },
    {
      "pattern": "[\\p{L}\\p{N}_./\\\\:-]+\\.(?:py|js|jsx|ts|tsx|css|html|json|md|exe|ps1|sh|yaml|yml|toml|java|go|rs|cpp|h)(?::\\d+)?",
      "flags": "gu",
      "color": "#e8dc99"
    },
    {
      "pattern": "`[^`\\n]+`|\\b[A-Za-z_][\\w]*\\(\\)",
      "flags": "gu",
      "color": "#babaff"
    },
    {
      "pattern": "\\b\\d+(?:\\.\\d+)?(?:\\s?(?:KiB|MiB|ms|tokens|\\u5b57\\u8282))?",
      "flags": "gu",
      "color": "#babaff"
    }
  ]
}
