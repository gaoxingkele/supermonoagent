{
  "id": "claude-code",
  "label": "Claude Code",
  "theme": {
    "background": "#1d1615",
    "foreground": "#fff0e5",
    "cursor": "#ffccb0",
    "cursorAccent": "#1d1615",
    "selectionBackground": "#39465c",
    "black": "#1d1615",
    "red": "#ef8d98",
    "green": "#a9dca9",
    "yellow": "#e7d18b",
    "blue": "#94bcea",
    "magenta": "#cca9e4",
    "cyan": "#ffccb0",
    "white": "#fff0e5",
    "brightBlack": "#8490a3",
    "brightRed": "#ffb2bc",
    "brightGreen": "#c5f4b9",
    "brightYellow": "#ffedba",
    "brightBlue": "#bdd9ff",
    "brightMagenta": "#ebc7ff",
    "brightCyan": "#bcf4f5",
    "brightWhite": "#ffffff"
  },
  "tokens": [
    {
      "pattern": "\\bClaude(?: Code)?\\b",
      "flags": "iu",
      "color": "#ffccb0"
    },
    {
      "pattern": "\\b(?:Read|Edit|Write|Bash|Glob|Grep)\\b",
      "flags": "iu",
      "color": "#ffe6a7"
    },
    {
      "pattern": "\\b(?:Thinking|Compact|Context)\\b",
      "flags": "iu",
      "color": "#e7c0ff"
    },
    {
      "pattern": "\\b(?:Error|Denied|Failed)\\b",
      "flags": "iu",
      "color": "#ffb8bd"
    }
  ]
}
