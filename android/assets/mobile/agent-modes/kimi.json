{
  "id": "kimi",
  "label": "Kimi",
  "theme": {
    "background": "#14152a",
    "foreground": "#f1eeff",
    "cursor": "#d1bfff",
    "cursorAccent": "#14152a",
    "selectionBackground": "#39465c",
    "black": "#14152a",
    "red": "#ef8d98",
    "green": "#a9dca9",
    "yellow": "#e7d18b",
    "blue": "#94bcea",
    "magenta": "#cca9e4",
    "cyan": "#d1bfff",
    "white": "#f1eeff",
    "brightBlack": "#8490a3",
    "brightRed": "#ffb2bc",
    "brightGreen": "#c5f4b9",
    "brightYellow": "#ffedba",
    "brightBlue": "#bdd9ff",
    "brightMagenta": "#ebc7ff",
    "brightCyan": "#bcf4f5",
    "brightWhite": "#ffffff"
  },
  "tokens": [
    {
      "pattern": "\\b(?:Kimi|Moonshot)\\b",
      "flags": "iu",
      "color": "#d1bfff"
    },
    {
      "pattern": "\\b(?:Swarm|Agent|Subagent)\\b",
      "flags": "iu",
      "color": "#a8e2ff"
    },
    {
      "pattern": "(?:思考|搜索|工具|任务)",
      "flags": "iu",
      "color": "#d2f2b0"
    },
    {
      "pattern": "\\b(?:Done|Ready|Completed)\\b",
      "flags": "iu",
      "color": "#f5dcaa"
    }
  ]
}
