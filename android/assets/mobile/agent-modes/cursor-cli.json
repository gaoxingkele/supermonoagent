{
  "id": "cursor-cli",
  "label": "Cursor CLI",
  "theme": {
    "background": "#18191b",
    "foreground": "#f4f6fb",
    "cursor": "#cedbfa",
    "cursorAccent": "#18191b",
    "selectionBackground": "#39465c",
    "black": "#18191b",
    "red": "#ef8d98",
    "green": "#a9dca9",
    "yellow": "#e7d18b",
    "blue": "#94bcea",
    "magenta": "#cca9e4",
    "cyan": "#cedbfa",
    "white": "#f4f6fb",
    "brightBlack": "#8490a3",
    "brightRed": "#ffb2bc",
    "brightGreen": "#c5f4b9",
    "brightYellow": "#ffedba",
    "brightBlue": "#bdd9ff",
    "brightMagenta": "#ebc7ff",
    "brightCyan": "#bcf4f5",
    "brightWhite": "#ffffff"
  },
  "tokens": [
    {
      "pattern": "\\bCursor(?: CLI| Agent)?\\b",
      "flags": "iu",
      "color": "#cedbfa"
    },
    {
      "pattern": "(?:/model|/mode|/plan|/ask)",
      "flags": "iu",
      "color": "#b2e6ff"
    },
    {
      "pattern": "\\b(?:Agent|Plan|Ask|Auto)\\b",
      "flags": "iu",
      "color": "#e2c7ff"
    },
    {
      "pattern": "\\b(?:Accepted|Applied|Completed)\\b",
      "flags": "iu",
      "color": "#b7edca"
    }
  ]
}
