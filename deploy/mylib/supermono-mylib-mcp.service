[Unit]
Description=SuperMono mylib MCP (independent of terminal relay)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=supermono-mylib
Group=supermono-mylib
WorkingDirectory=/opt/supermono-mylib/app
EnvironmentFile=/etc/supermono-mylib/runtime.env
Environment=LD_LIBRARY_PATH=/opt/supermono-mylib/runtime/lib
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONUTF8=1
ExecStart=/opt/supermono-mylib/venv/bin/python -m supermonoagent.mylib_mcp --store-root /var/lib/supermono-mylib/store --auth-file /etc/supermono-mylib/auth.json --state-root /var/lib/supermono-mylib/review --engine-root ${MYLIB_ENGINE_ROOT} --host 127.0.0.1 --port 8821 --allowed-host 127.0.0.1 --allowed-host localhost --allowed-host 117.50.48.22 --allowed-origin https://117.50.48.22 --max-concurrency 2
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/supermono-mylib/store
ReadWritePaths=/var/lib/supermono-mylib/review
RestrictSUIDSGID=true
CapabilityBoundingSet=
MemoryMax=512M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
